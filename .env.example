# GoalFlow device agent v2 — LLM configuration (OpenRouter, OpenAI-compatible).
# v2 is LLM-ONLY: planning always goes through the SK kernel, so these are
# required. Copy to .env and fill in.

OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# Per-call LLM deadlines (seconds). Raise these if a large/slow model or provider load
# cancels planning mid-compose ("transient provider error (TaskCanceledException)"); a
# healthy compose finishes well under the default. Optional — defaults apply if unset.
# LLM_CALL_TIMEOUT_SECONDS=180     # non-streaming compose / adaptation
# LLM_STREAM_TIMEOUT_SECONDS=210   # streaming grounding pass

# --- v8: OpenRouter PROVIDER ROUTING. The single biggest latency lever there is. ---
#
# Unset, OpenRouter load-balances this model across nineteen endpoints whose throughput
# spans 39x, and it kept landing on the slow ones. Measured, same input, same afternoon:
# four unpinned runs took 59s / 175s / 145s / 189s. Pinned to Cerebras: 8.4s / 8.4s /
# 8.7s / 10.1s. Same task benchmarked alone — 50.1s unpinned (CoreWeave, 52 tok/s) vs
# 1.5s (Cerebras, 1523 tok/s).
#
# allow_fallbacks defaults TRUE: a busy Cerebras should cost you Groq (still ~9x better
# than unpinned), not the demo.
OPENROUTER_PROVIDER_ORDER=cerebras,groq
# OPENROUTER_PROVIDER_ALLOW_FALLBACKS=true

# Escape hatch for the full OpenRouter provider object (wins over ORDER/ALLOW_FALLBACKS):
# OPENROUTER_PROVIDER_JSON={"only":["cerebras"],"allow_fallbacks":false}

# --- v8: reasoning_effort. BUILT, DOCUMENTED, AND DELIBERATELY LEFT OFF. ---
#
# DO NOT SET THIS TO "low" WITHOUT RE-MEASURING. Benchmarked on every provider: reasoning
# tokens collapse from ~1400 to 26-89 and the model stops being able to do the job — every
# single "low" run returned an INVALID plan. Nor is there anything to win: "medium" and the
# provider default are within 0.2s of each other once the provider is fast (1.7s vs 1.5s).
# The knob is here for a future model, not this one.
#
# Values: minimal | low | medium | high | off. Global first, then per-site overrides.
# LLM_REASONING_EFFORT=medium
# LLM_REASONING_EFFORT_DECOMPOSE=medium
# LLM_REASONING_EFFORT_GROUNDING=medium
# LLM_REASONING_EFFORT_COMPOSE=off
# LLM_REASONING_EFFORT_ADAPT=off

# --- v8: COST vs SPEED. Measured on the REAL pipeline, not a benchmark. ---
#
# Cerebras is both the fastest AND the most expensive endpoint for this model: $0.35/M in
# against CoreWeave's $0.03 (11.7x) and $0.75/M out against $0.17 (4.4x). That looks like an
# obvious place to save money. It is not. Every alternative was run through the actual device
# pipeline — 21 tools, ~6 grounding rounds, a 5.6k-token compose — and the wall-clock cost is
# wildly out of proportion to the saving:
#
#   OPENROUTER_PROVIDER_ORDER      goal wall-clock   ~$/goal   plan quality
#   cerebras,groq                        8-10s        0.016    good          <- USE THIS
#   groq                                  234s        0.010    good
#   nebius,groq                           203s        0.010    good
#   deepinfra,coreweave                   551s        0.004    good
#   (unpinned, the v7 default)         59-189s        0.010    good
#   + OPENROUTER_MODEL=...gpt-oss-20b      85s        0.010    BROKEN: empty grounding summary
#
# 20-60x the wall-clock to save about a cent. At Cerebras prices a goal costs roughly 1.5
# cents, so a hundred-goal day is about $1.50 — you will spend more of your own time waiting
# than you will ever save in credits. gpt-oss-20b is not a cheaper option at all: it returned
# an EMPTY grounding summary (chars=0), which the pipeline accepts and plans around.
#
# IF YOU ARE ITERATING AND DO NOT NEED A REAL PLAN, do not pay for one. The gates run fully
# offline with no API calls and no key:
#     OPENROUTER_API_KEY=dump-mode ./verify/v8-m1/check.sh     # 29 gates, device
# That is the actual zero-cost development path, and it covers far more than a hand-run goal.
#
# A per-run override needs no editing (the .env no longer clobbers the environment):
#     OPENROUTER_PROVIDER_ORDER=deepinfra dotnet run --project GoalFlow.Device.csproj -- --goal "..."
